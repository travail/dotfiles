#!/bin/bash
# gh-ci-watch: poll GitHub CI until every check is settled, then print a
# summary and exit. Unlike `gh pr checks --watch` / `gh run watch`, it never
# depends on the gh CLI deciding to exit: it owns the polling loop, waits out
# the "0 checks right after PR creation / rerun" lag, and has an absolute timeout.
#
# Exit codes:
#   0  all checks passed (skipped checks count as passed)
#   1  at least one check failed or was cancelled
#   2  usage error
#   3  timed out while checks were still pending
#   4  no checks were registered within the grace period
set -uo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: gh-ci-watch [options] [<pr-number|pr-url|branch>]
       gh-ci-watch [options] --run <run-id>

Options:
  -R, --repo OWNER/REPO  Target repository (default: current repository)
  --run RUN_ID           Watch a workflow run instead of a PR's checks
  -t, --timeout SEC      Absolute timeout in seconds (default: 600)
  -i, --interval SEC     Polling interval in seconds (default: 10)
  -g, --grace SEC        Time to wait for checks to be registered when
                         none exist yet (default: 30)
  -h, --help             Show this help
EOF
}

die_usage() {
  echo "gh-ci-watch: $1" >&2
  usage
  exit 2
}

is_uint() {
  case "$1" in
    '' | *[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

repo=""
run_id=""
target=""
timeout=600
interval=10
grace=30

while [ $# -gt 0 ]; do
  case "$1" in
    -R | --repo)
      [ $# -ge 2 ] || die_usage "$1 requires a value"
      repo="$2"
      shift 2
      ;;
    --run)
      [ $# -ge 2 ] || die_usage "$1 requires a value"
      run_id="$2"
      shift 2
      ;;
    -t | --timeout)
      [ $# -ge 2 ] || die_usage "$1 requires a value"
      timeout="$2"
      shift 2
      ;;
    -i | --interval)
      [ $# -ge 2 ] || die_usage "$1 requires a value"
      interval="$2"
      shift 2
      ;;
    -g | --grace)
      [ $# -ge 2 ] || die_usage "$1 requires a value"
      grace="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      die_usage "unknown option: $1"
      ;;
    *)
      [ -z "$target" ] || die_usage "only one target may be given"
      target="$1"
      shift
      ;;
  esac
done

is_uint "$timeout" && [ "$timeout" -gt 0 ] || die_usage "--timeout must be a positive integer"
is_uint "$interval" && [ "$interval" -gt 0 ] || die_usage "--interval must be a positive integer"
is_uint "$grace" || die_usage "--grace must be a non-negative integer"
if [ -n "$run_id" ]; then
  is_uint "$run_id" || die_usage "--run must be a numeric run ID"
  [ -z "$target" ] || die_usage "--run cannot be combined with a PR/branch target"
fi

repo_args=()
if [ -n "$repo" ]; then
  repo_args=(-R "$repo")
fi

start=$SECONDS

# Each fetcher prints a normalized JSON array of {name, bucket, link} where
# bucket is one of: pass | fail | pending | skipping | cancel.
# A failed gh call (network blip, no checks yet) yields "[]" so the loop keeps
# polling until the grace period / timeout decides the outcome.
fetch_pr() {
  local args=(pr checks)
  [ -n "$target" ] && args+=("$target")
  args+=("${repo_args[@]}" --json name,bucket,link)
  local out
  out=$(gh "${args[@]}" 2>/dev/null) || true
  if printf '%s' "$out" | jq -e 'type == "array"' >/dev/null 2>&1; then
    printf '%s' "$out"
  else
    echo '[]'
  fi
}

fetch_run() {
  local out
  out=$(gh run view "$run_id" "${repo_args[@]}" --json status,conclusion,jobs 2>/dev/null) || true
  if ! printf '%s' "$out" | jq -e 'type == "object"' >/dev/null 2>&1; then
    echo '[]'
    return
  fi
  printf '%s' "$out" | jq -c '
    (.status // "") as $status
    | (.conclusion // "") as $conclusion
    | [ .jobs[]? |
        { name: .name,
          link: (.url // ""),
          bucket:
            (if .status != "completed" then "pending"
             elif .conclusion == "success" then "pass"
             elif .conclusion == "skipped" or .conclusion == "neutral" then "skipping"
             elif .conclusion == "cancelled" then "cancel"
             else "fail" end) } ]
    | if length == 0 and $status != "" and $status != "completed" then
        [ { name: "(run)", link: "", bucket: "pending" } ]
      elif length == 0 and $status == "completed" then
        [ { name: "(run)", link: "",
            bucket: (if $conclusion == "success" then "pass" else "fail" end) } ]
      else . end'
}

fetch() {
  if [ -n "$run_id" ]; then
    fetch_run
  else
    fetch_pr
  fi
}

print_summary() {
  printf '%s' "$1" | jq -r '.[] | "\(.bucket)\t\(.name)\t\(.link)"'
}

what="PR checks${target:+ ($target)}"
[ -n "$run_id" ] && what="run $run_id"
echo "gh-ci-watch: watching $what (timeout ${timeout}s, interval ${interval}s, grace ${grace}s)" >&2

while true; do
  checks=$(fetch)
  total=$(printf '%s' "$checks" | jq 'length')
  pending=$(printf '%s' "$checks" | jq '[.[] | select(.bucket == "pending")] | length')
  elapsed=$((SECONDS - start))

  if [ "$total" -gt 0 ] && [ "$pending" -eq 0 ]; then
    print_summary "$checks"
    bad=$(printf '%s' "$checks" | jq '[.[] | select(.bucket == "fail" or .bucket == "cancel")] | length')
    if [ "$bad" -gt 0 ]; then
      echo "gh-ci-watch: $bad of $total checks failed" >&2
      exit 1
    fi
    echo "gh-ci-watch: all $total checks passed" >&2
    exit 0
  fi

  if [ "$total" -eq 0 ] && [ "$elapsed" -ge "$grace" ]; then
    echo "gh-ci-watch: no checks registered within ${grace}s" >&2
    exit 4
  fi

  if [ "$elapsed" -ge "$timeout" ]; then
    print_summary "$checks"
    echo "gh-ci-watch: timed out after ${timeout}s ($pending of $total checks still pending)" >&2
    exit 3
  fi

  echo "gh-ci-watch: ${elapsed}s: $pending pending / $total total" >&2
  sleep "$interval"
done
