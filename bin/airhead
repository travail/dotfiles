#!/usr/bin/env bash
#
# airhead - Output-limiting wrapper and pipe filter for AI agents
#
# Origin:
#   Introduced in Issue #197 (https://github.com/travail/dotfiles/issues/197)
#
# Design & Architecture:
#   1. Token-Efficient Output Truncation:
#      Large test or build logs consume excessive agent context tokens when read
#      in full. When total output exceeds N + M lines (default: head 20, tail 50),
#      `airhead` prints only the first N lines, an omission summary with the full
#      log path, and the last M lines. Shorter outputs pass through untouched
#      without leaving a cache file behind.
#
#   2. Command Wrapper & Pipe Filter:
#      Supports both command-wrapper mode (`airhead [options] [--] <cmd> [args...]`)
#      and stdin pipe mode (`cmd | airhead [options]` or `airhead -`). Option
#      parsing stops at the first non-option argument or `--` so flags intended
#      for the wrapped command are never intercepted. When invoked with no command
#      and a TTY stdin, `airhead` fails fast with usage and exit code 1.
#
#   3. Exit Code Preservation & Atomic Cache Storage:
#      Captures stdout and stderr into a temporary file under AIRHEAD_CACHE_DIR
#      (default: ~/.cache/airhead) and preserves the wrapped command's exit code.
#      When truncation occurs, the temporary file is atomically renamed to
#      <YYYYMMDD-HHMMSS>-<PID>-<RANDOM>.log and stale logs older than 7 days
#      (10,080 minutes) are pruned synchronously.
#

set -euo pipefail

CACHE_ROOT="${AIRHEAD_CACHE_DIR:-$HOME/.cache/airhead}"
DEFAULT_HEAD="${AIRHEAD_HEAD:-20}"
DEFAULT_TAIL="${AIRHEAD_TAIL:-50}"

show_help() {
  cat <<'EOF'
usage: airhead [options] [--] <command> [args...]
       <command> 2>&1 | airhead [options]
       airhead [options] -
       airhead --clean [days]
       airhead -h | --help

Limit verbose command output for AI agents while saving the full log on truncation.

Options:
  -n, --head <N>   Number of leading lines to display (default: 20, env: AIRHEAD_HEAD)
  -m, --tail <M>   Number of trailing lines to display (default: 50, env: AIRHEAD_TAIL)
  -h, --help       Display this help and exit

Maintenance:
  --clean [days]   Remove cached .log files older than [days] days
                   (removes all cached .log files if days is 0 or omitted)
EOF
}

validate_non_negative_int() {
  local label="$1"
  local value="$2"
  if ! [[ "$value" =~ ^[0-9]+$ ]]; then
    echo "airhead: $label: invalid non-negative integer: $value" >&2
    exit 1
  fi
  echo "$((10#$value))"
}

clean_cache() {
  local days="${1:-0}"
  local days_num
  days_num=$(validate_non_negative_int "--clean" "$days")

  if [[ ! -d "$CACHE_ROOT" ]]; then
    return 0
  fi

  if [[ "$days_num" -eq 0 ]]; then
    find "$CACHE_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.log' -exec /bin/rm -f {} + 2>/dev/null || true
  else
    local minutes=$((days_num * 1440))
    find "$CACHE_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.log' -mmin +"$minutes" -exec /bin/rm -f {} + 2>/dev/null || true
  fi
}

prune_cache_auto() {
  if [[ -d "$CACHE_ROOT" ]]; then
    # 7 days = 10080 minutes
    find "$CACHE_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.log' -mmin +10080 -exec /bin/rm -f {} + 2>/dev/null || true
  fi
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  show_help
  exit 0
fi

if [[ "${1:-}" == "--clean" ]]; then
  shift
  days=0
  if [[ $# -eq 1 ]]; then
    days="$1"
  elif [[ $# -gt 1 ]]; then
    echo "airhead: --clean: too many arguments" >&2
    exit 1
  fi
  clean_cache "$days"
  exit 0
fi

head_lines="$DEFAULT_HEAD"
tail_lines="$DEFAULT_TAIL"
use_stdin=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      break
      ;;
    -)
      use_stdin=true
      shift
      break
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    -n | --head)
      if [[ $# -lt 2 ]]; then
        echo "airhead: option $1 requires an argument" >&2
        exit 1
      fi
      head_lines="$2"
      shift 2
      ;;
    --head=*)
      head_lines="${1#--head=}"
      shift
      ;;
    -m | --tail)
      if [[ $# -lt 2 ]]; then
        echo "airhead: option $1 requires an argument" >&2
        exit 1
      fi
      tail_lines="$2"
      shift 2
      ;;
    --tail=*)
      tail_lines="${1#--tail=}"
      shift
      ;;
    --clean)
      echo "airhead: --clean cannot be combined with other options" >&2
      exit 1
      ;;
    -*)
      echo "airhead: illegal option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

head_lines=$(validate_non_negative_int "head" "$head_lines")
tail_lines=$(validate_non_negative_int "tail" "$tail_lines")

if [[ "$use_stdin" == true && $# -gt 0 ]]; then
  echo "airhead: unexpected arguments after '-': $*" >&2
  exit 1
fi

if [[ "$use_stdin" == false && $# -eq 0 ]]; then
  if [[ -t 0 ]]; then
    show_help >&2
    exit 1
  fi
  use_stdin=true
fi

mkdir -p "$CACHE_ROOT"
tmpfile="$(mktemp "$CACHE_ROOT/.tmp.XXXXXXXXXX")"
trap '/bin/rm -f "$tmpfile" 2>/dev/null || true' EXIT

rc=0
if [[ "$use_stdin" == true ]]; then
  cat >"$tmpfile" || rc=$?
else
  "$@" >"$tmpfile" 2>&1 || rc=$?
fi

if [[ ! -s "$tmpfile" ]]; then
  exit "$rc"
fi

total_lines=$(wc -l <"$tmpfile")
total_lines="${total_lines//[[:space:]]/}"
if [[ "$(tail -c 1 "$tmpfile" | wc -l)" -eq 0 ]]; then
  total_lines=$((total_lines + 1))
fi

if [[ "$total_lines" -le $((head_lines + tail_lines)) ]]; then
  cat "$tmpfile"
  exit "$rc"
fi

logfile="$CACHE_ROOT/$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}.log"
mv "$tmpfile" "$logfile"

if [[ "$head_lines" -gt 0 ]]; then
  head -n "$head_lines" "$logfile"
fi

omitted=$((total_lines - head_lines - tail_lines))
echo "... (omitted ${omitted} lines; full output: ${logfile}) ..."

if [[ "$tail_lines" -gt 0 ]]; then
  tail -n "$tail_lines" "$logfile"
fi

prune_cache_auto
exit "$rc"
