#!/bin/bash
set -euo pipefail
# Spawn a claude agent pane primed for hub-and-spoke multi-agent coordination
# (/herdr + /herdr-hub).

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=bin/herdr-common.sh
source "$SCRIPT_DIR/herdr-common.sh"

spawn_agent "herdr-spawn-hub-agent" "herdr herdr-hub" "$@"
