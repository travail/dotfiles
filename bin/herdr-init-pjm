#!/bin/bash
set -euo pipefail
# Set up a Project Workspace with Tab 1 dedicated to the PjM (Project Manager)
# agent in a 1+1 layout (top ~70% PjM agent, bottom ~30% plain terminal) and
# inject /herdr-pjm.

usage() {
  cat <<'EOF'
Usage: herdr-init-pjm [-h|--help] [-f] [-A AGENT] [-m MODEL] [-e EFFORT] <project_dir> [workspace_label]

Arguments:
  project_dir      Target project directory for the workspace. (required)
  workspace_label  Label for the workspace. (default: basename of project_dir)

Options:
  -A AGENT  Agent type: agy or claude. (default: agy)
  -m MODEL  Model name override.
  -e EFFORT Effort level override.
  -f        Focus the newly created workspace.
  -h, --help Show this help and exit.
EOF
}

if [ $# -gt 0 ]; then
  ARGS=()
  for arg in "$@"; do
    if [ "$arg" = "--help" ]; then
      ARGS+=("-h")
    else
      ARGS+=("$arg")
    fi
  done
  set -- "${ARGS[@]}"
fi

AGENT="agy"
MODEL=""
EFFORT=""
FOCUS=0

while getopts "hfA:m:e:" OPT; do
  case "$OPT" in
    A) AGENT="$OPTARG" ;;
    m) MODEL="$OPTARG" ;;
    e) EFFORT="$OPTARG" ;;
    f) FOCUS=1 ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

if [ $# -lt 1 ]; then
  usage >&2
  exit 1
fi

DIR=$(cd "$1" && pwd)
WS_LABEL="${2:-$(basename "$DIR")}"

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=bin/herdr-common.sh
source "$SCRIPT_DIR/herdr-common.sh"

WS_JSON=$(herdr workspace create --cwd "$DIR" --label "$WS_LABEL")
WORKSPACE_ID=$(echo "$WS_JSON" | jq -r '.result.workspace.workspace_id')
TAB_ID=$(echo "$WS_JSON" | jq -r '.result.tab.tab_id')
ROOT_PANE=$(echo "$WS_JSON" | jq -r '.result.root_pane.pane_id')

herdr tab rename "$TAB_ID" "pjm" >&2

TOP_PANE=$(setup_1_plus_1_tab "$ROOT_PANE" "${WS_LABEL}-pjm" "$AGENT" "$MODEL" "$EFFORT" "/herdr-pjm")

if [ "$FOCUS" -eq 1 ]; then
  herdr workspace focus "$WORKSPACE_ID" >&2
fi

echo "$TOP_PANE"
