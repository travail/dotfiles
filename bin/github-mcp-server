#!/usr/bin/env bash
set -euo pipefail
# Launcher that injects the gh auth token into the Homebrew-installed
# github-mcp-server binary. It shares the binary's name, so ~/bin must stay
# after Homebrew's bin in PATH (see zshrc); otherwise the exec below would
# call this script again.
export GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token)"
exec github-mcp-server stdio
