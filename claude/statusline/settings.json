{
  "version": 4,
  "lines": [
    [
      {
        "id": "model",
        "type": "model"
      },
      {
        "id": "effort",
        "type": "thinking-effort"
      },
      {
        "id": "session-name",
        "type": "session-name"
      },
      {
        "id": "branch",
        "type": "git-branch",
        "rawValue": true
      },
      {
        "id": "changes",
        "type": "git-changes"
      }
    ],
    [
      {
        "id": "txt-ctx",
        "type": "custom-text",
        "customText": "Ctx: ",
        "merge": "no-padding"
      },
      {
        "id": "context",
        "type": "context-percentage",
        "rawValue": true
      },
      {
        "id": "enterprise-credit",
        "type": "custom-command",
        "commandPath": "claude-statusline-enterprise-credit",
        "timeout": 5000,
        "dim": "parens"
      },
      {
        "id": "cost",
        "type": "session-cost"
      }
    ]
  ],
  "flexMode": "full",
  "compactThreshold": 60,
  "colorLevel": 3,
  "defaultPadding": "  ",
  "defaultPaddingSide": "both",
  "inheritSeparatorColors": false,
  "globalBold": false,
  "gitCacheTtlSeconds": 5,
  "terminalWidthCacheTtlSeconds": 5,
  "customCommandCacheTtlSeconds": 30,
  "minimalistMode": false,
  "powerline": {
    "enabled": true,
    "separators": [
      ""
    ],
    "separatorInvertBackground": [
      false
    ],
    "startCaps": [
      ""
    ],
    "endCaps": [
      ""
    ],
    "autoAlign": false,
    "continueThemeAcrossLines": false,
    "theme": "solarized"
  }
}
